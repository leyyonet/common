{
  "name": "@leyyo/common",
  "version": "1.3.16",
  "description": "Leyyo common library",
  "keywords": [
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leyyonet/common.git"
  },
  "bugs": {
    "url": "https://github.com/leyyonet/common.git/issues",
    "email": "mustafayelmer@gmail.com"
  },
  "homepage": "https://github.com/leyyonet/common.git/#readme",
  "author": "Mustafa Yelmer <mustafayelmer@gmail.com>",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clear": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "asset": "node -r ts-node/register commands/assets.js",
    "build": "npm run clear && tsc && npm run asset",
    "test": "npx jest --config=jest.json --clearCache && npx jest --config=jest.json --verbose",
    "test:watch": "jest --watch --config=jest.json",
    "test:coverage": "jest --config=jest.json --coverage --coverageDirectory=coverage",
    "~publish": "npm run build && npm publish -access=public"
  },
  "files": [
    "dist/*"
  ],
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "^9.33.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.2.1",
    "@types/node-localstorage": "^1.3.3",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^54.0.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "test": "^3.3.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "overrides": {
    "eslint-config-standard": {
      "eslint": "^9.33.0"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "node-localstorage": "^3.0.5",
    "stacktrace-parser": "^0.1.11"
  }
}
